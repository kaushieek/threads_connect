{
  "name": "@threads-connect/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @threads-connect/database prisma:generate",
    "build": "nest build",
    "pretypecheck": "pnpm --filter @threads-connect/database prisma:generate",
    "test": "node --test test/*.test.cjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@threads-connect/config": "workspace:*",
    "@threads-connect/database": "workspace:*",
    "@threads-connect/types": "workspace:*",
    "dotenv": "^17.4.2",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/pg": "^8.15.5",
    "typescript": "^6.0.3"
  }
}
