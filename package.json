{
  "name": "threads-connect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @threads-connect/database prisma:generate",
    "db:migrate": "pnpm --filter @threads-connect/database prisma:migrate",
    "db:studio": "pnpm --filter @threads-connect/database prisma:studio",
    "infra:up": "docker compose -f infrastructure/docker/compose.yaml up -d",
    "infra:down": "docker compose -f infrastructure/docker/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "@next/eslint-plugin-next": "16.4.6",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "turbo": "2.11.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4"
  }
}
